# Local configuration example (code reference: 2026-10-02).
# Copy to the repository root .env only when it does not already exist.
# Backend and AI read it; Vite envDir also points to the repository root.
# Fill in required credentials. Never commit .env or prefix secrets with VITE_.
# Use simple unquoted NAME=value lines for Spring/Python interoperability.

# Backend server
BACKEND_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# MySQL
DB_URL=jdbc:mysql://localhost:3306/memory_space
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Mail verification
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_CODE_TTL_SECONDS=300

# Auth
SA_TOKEN_JWT_SECRET=

# MinIO / object storage
MINIO_URL=http://127.0.0.1:9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pictures
MINIO_SECURE=false

# AMap / geocoder
AMAP_API_KEY=
AMAP_GEO_URL=https://restapi.amap.com/v3/geocode/regeo

# Backend -> AI service
AI_SERVICE_URL=http://localhost:5000

MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8089
ASYNC_TASK_ADMIN_USER_IDS=
ASYNC_TASK_FACE_RECOVERY_ENABLED=true
ASYNC_TASK_VIDEO_RECOVERY_ENABLED=true
ASYNC_TASK_GEO_RECOVERY_ENABLED=true
ASYNC_TASK_TAG_RECOVERY_ENABLED=false
AI_FEATURE_PROVIDER=aliyun
AI_FEATURE_MODEL=qwen3-vl-embedding
AI_FEATURE_VERSION=v1
AI_FACE_DETECT_PROVIDER=aliyun-qwen-vl-face-detect
AI_TAG_RUNNING_TIMEOUT_SECONDS=180
FACE_CLUSTER_COSINE_THRESHOLD=0.68

# Dify custom-tool credential, stored only in Dify server credential settings.
# Generate independent random secrets of at least 32 characters. Never use VITE_ prefixes.
# Backend and AI manual startup both read the repository root .env.
# AI_SERVICE_KEY must match on both sides; environment variables override files.
# ai-service/.env, when present, overrides the root file for the AI process.
# Replace owner 0 with the existing personal library owner's ID for Dify access.
AGENT_SERVICE_KEY=
AGENT_OWNER_USER_ID=0
AI_SERVICE_KEY=
AGENT_PUBLIC_WEB_URL=http://localhost:8080
AGENT_PUBLIC_API_URL=http://localhost:8080/devApi
AGENT_PENDING_ACTION_TTL_SECONDS=300
AGENT_WORKFLOW_VERSION=1.6.0
AGENT_PENDING_ACTION_EXECUTION_LEASE_SECONDS=120
AGENT_PENDING_ACTION_CLEANUP_DELAY_MS=60000
AGENT_PENDING_ACTION_CLEANUP_INITIAL_DELAY_MS=60000

# AI service
AI_SERVICE_HOST=127.0.0.1
AI_DAILY_MODEL_CALL_LIMIT=500
AI_DECODE_MAX_PIXELS=40000000
AI_SERVICE_PORT=5000
AI_SERVICE_DEBUG=false
DASHSCOPE_API_KEY=
DASHSCOPE_COMPATIBLE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MULTIMODAL_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VISION_MODEL=qwen3-vl-flash
EMBEDDING_MODEL=qwen3-vl-embedding
AI_REQUEST_TIMEOUT_SECONDS=60
AI_TOP_TAGS=8
AI_IMAGE_MAX_EDGE=1280
AI_IMAGE_MAX_PIXELS=1200000
AI_IMAGE_JPEG_QUALITY=82
AI_FACE_MAX_FACES=10
AI_FACE_MIN_CONFIDENCE=0.25
AI_FACE_CROP_EXPAND_RATIO=0.18

# Frontend: public configuration only. There is no browser-to-AI /mockApi proxy.
VITE_BACKEND_API=/devApi
# Published Dify WebApp URL; /chatbot/<id> is normalized to /chat/<id> by the UI.
# A URL saved through the assistant settings in this browser takes precedence.
VITE_DIFY_AGENT_URL=
