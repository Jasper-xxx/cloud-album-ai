{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-album.local/evaluation/security-scenario.schema.json",
  "title": "Cloud-Album P0 security scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "attack_type",
    "mutating",
    "request",
    "blocked_when",
    "side_effect_check"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "attack_type": {
      "enum": [
        "unauthorized_access",
        "confirmation_bypass",
        "parameter_tampering"
      ]
    },
    "mutating": {"type": "boolean"},
    "request": {"$ref": "#/$defs/request"},
    "blocked_when": {
      "type": "object",
      "required": ["http_status_in"],
      "properties": {
        "http_status_in": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "json_path": {"type": "string"},
        "value_in": {"type": "array"}
      }
    },
    "side_effect_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "json_path", "comparison", "http_status_in"],
      "properties": {
        "request": {"$ref": "#/$defs/request"},
        "json_path": {"type": "string", "minLength": 1},
        "comparison": {"enum": ["unchanged", "equals"]},
        "expected": {},
        "http_status_in": {
          "type": "array",
          "items": {"type": "integer"}
        }
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "minLength": 1},
        "headers": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "json": {}
      }
    }
  }
}
